# Creator mode login. Choose a long password. Without this, /creator stays switched off.
CREATOR_PASSWORD=

# Optional: secret used to sign the login cookie (any long random string). Falls back to a key derived from CREATOR_PASSWORD.
SESSION_SECRET=

# Added automatically when you create a PUBLIC Blob store in Vercel (Storage tab). Needed to save edits and uploads in production.
BLOB_READ_WRITE_TOKEN=

# Contact form (optional, via Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: your production URL, used for SEO and the sitemap
NEXT_PUBLIC_SITE_URL=
